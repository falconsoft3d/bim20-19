<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_payment_schedule_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.payment.schedule.wizard.form</field>
        <field name="model">purchase.payment.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Programar pagos">
                <sheet>
                    <group>
                        <field name="purchase_id"/>
                        <field name="payment_term_id"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="fecha_prevista"/>
                            <field name="percentage"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply" string="Crear programación" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>