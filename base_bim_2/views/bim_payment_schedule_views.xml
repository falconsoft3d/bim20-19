<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista lista -->
        <record id="bim_payment_schedule_view_list" model="ir.ui.view">
            <field name="name">bim.payment.schedule.view.list</field>
            <field name="model">bim.payment.schedule</field>
            <field name="arch" type="xml">
                <list string="Programación de Pagos" delete="false">
                    <field name="name"/>
                    <field name="purchase_id" optional="show"/>
                    <field name="partner_id" optional="show"/>
                    <field name="project_id" optional="show"/>
                    <field name="fecha_prevista" optional="show"/>
                    <field name="fecha_real" optional="show"/>
                    <field name="importe_a_pagar" optional="show" sum="Total"/>
                    <field name="como_se_paga" optional="show"/>
                    <field name="aprobado_tecnico" optional="show" groups="base_bim_2.group_purchase_technical_approver"/>
                    <field name="aprobado_finanzas" optional="show" groups="base_bim_2.group_purchase_finance_approver"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="state"
                           widget="badge"
                           decoration-muted="state == 'draft'"
                           decoration-info="state == 'planned'"
                           decoration-warning="state == 'approved'"
                           decoration-success="state == 'done'"
                           optional="show"/>
                </list>
            </field>
        </record>

        <!-- Vista formulario -->
        <record id="bim_payment_schedule_view_form" model="ir.ui.view">
            <field name="name">bim.payment.schedule.view.form</field>
            <field name="model">bim.payment.schedule</field>
            <field name="arch" type="xml">
                <form string="Programación de Pagos" delete="false">
                    <header>
                        <button name="action_planned" string="Planificar"
                                invisible="state != 'draft'"
                                type="object" class="oe_highlight"/>
                        <button name="action_approve" string="Aprobar"
                                invisible="state != 'planned'"
                                type="object" class="oe_highlight"/>
                        <button name="action_done" string="Marcar como Hecho"
                                invisible="state != 'approved'"
                                type="object" class="oe_highlight"/>
                        <button name="action_draft" string="Borrador"
                                invisible="state == 'draft'"
                                type="object"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,planned,approved,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Información Principal">
                                <field name="purchase_id"
                                       required="1"
                                       readonly="state != 'draft'"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="project_id" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                            </group>
                            <group string="Fechas e Importes">
                                <field name="fecha_prevista"/>
                                <field name="fecha_real"/>
                                <field name="importe_a_pagar" readonly="state != 'draft'"/>
                                <field name="como_se_paga" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group>
                            <group string="Aprobaciones">
                                <field name="aprobado_tecnico" widget="boolean_toggle" groups="base_bim_2.group_purchase_technical_approver"/>
                                <field name="aprobado_finanzas" widget="boolean_toggle" groups="base_bim_2.group_purchase_finance_approver"/>
                            </group>
                            <group string="Empresa">
                                <field name="company_id" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group string="Notas">
                            <field name="notas" nolabel="1" placeholder="Notas adicionales..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="bim_payment_schedule_view_pivot" model="ir.ui.view">
            <field name="name">bim.payment.schedule.view.pivot</field>
            <field name="model">bim.payment.schedule</field>
            <field name="arch" type="xml">
                <pivot string="Programación de Pagos">
                    <field name="partner_id" type="row"/>
                    <field name="project_id" type="col"/>
                    <field name="fecha_prevista" interval="month"/>
                    <field name="importe_a_pagar" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Acción -->
        <record id="bim_payment_schedule_action" model="ir.actions.act_window">
            <field name="name">Programación de Pagos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bim.payment.schedule</field>
            <field name="view_mode">list,pivot,form</field>
        </record>

    </data>
</odoo>
